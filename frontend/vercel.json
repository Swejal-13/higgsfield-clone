{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-sage-eight-49.vercel.app/api/:path*"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://backend-sage-eight-49.vercel.app/demo/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://backend-sage-eight-49.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
