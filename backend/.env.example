PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/higgsfield
JWT_SECRET=change-this-super-secret-key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Leave empty to use mock providers automatically.
# AI_IMAGE_API_KEY: a Google Gemini API key (https://aistudio.google.com/apikey).
# Powers ExternalImageProvider via gemini-2.5-flash-image ("Nano Banana"), free tier.
AI_IMAGE_API_KEY=
AI_VIDEO_API_KEY=
AI_AUDIO_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock generation timing (ms) - tweak to speed up/slow down demo
MOCK_IMAGE_DURATION_MS=4000
MOCK_VIDEO_DURATION_MS=8000
MOCK_AUDIO_DURATION_MS=3000
